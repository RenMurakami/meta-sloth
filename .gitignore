# This layer is added to a tegra-demo-distro tree from outside it, so no build
# output should ever land here.  These entries catch the accidents.

# Build output, if a build is ever pointed inside the layer by mistake
build*/
tmp/
sstate-cache/
downloads/
deploy/

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store

# Python
__pycache__/
*.pyc

# Secrets - never.  Note that sloth-authorized_keys is a PUBLIC key and lives in
# the build tree (~/yocto), referenced by SLOTH_SSH_AUTHORIZED_KEYS in local.conf,
# not in this layer.
*.key
*.pem
id_rsa
id_ed25519
.env

# On-device reports
sloth-net-debug.txt

# Output of scripts/sloth-target-check.sh
sloth-target-check.txt

# docs/ stays local.  This repository is public, and the bring-up notes,
# verification reports and the HTML reference record site details (host
# names, user names, MAC and IP addresses, Wi-Fi SSID, key fingerprints).
# Files that were already tracked are not affected by this rule; untrack them
# with:  git rm -r --cached docs
/docs/
